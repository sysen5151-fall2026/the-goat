# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.

# Basemap provider for MapLibre: geoapify | maptiler | openfreemap (keyless fallback)
NEXT_PUBLIC_MAP_PROVIDER=geoapify

# Browser keys (visible to users — restrict them to your domains in each dashboard)
NEXT_PUBLIC_GEOAPIFY_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

# Server-side key for the Geoapify Routing API (used by /api/plan).
# Can be the same Geoapify key; falls back to NEXT_PUBLIC_GEOAPIFY_KEY when empty.
GEOAPIFY_KEY=

# DeepSeek route selection (server-only; never prefix with NEXT_PUBLIC_).
# Without it, /api/plan always returns the rule-based (controlled) route.
DEEPSEEK_API_KEY=
# Optional overrides
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Max real model calls per day per server instance (default 50)
# DAILY_MODEL_CALL_LIMIT=50

# Supabase (accounts, saved plans, preferences, feedback, daily AI cap)
# Browser — public values only:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose to the browser:
SUPABASE_URL=
SUPABASE_SECRET_KEY=
